{
  "name": "esencia-glow",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce de Esencia Glow — skincare y lifestyle",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @esencia-glow/api dev",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "postinstall": "pnpm --filter @esencia-glow/shared build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "type": "module"
}
