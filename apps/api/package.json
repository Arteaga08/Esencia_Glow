{
  "name": "@esencia-glow/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Esencia Glow — Express 5 + TypeScript",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.development.local tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.development.local tsx src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@esencia-glow/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "resend": "^4.8.0",
    "sharp": "^0.35.4",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.1.4"
  }
}
