# Referencia de variables requeridas en producción. Los valores reales viven
# solo en el secrets manager del proveedor de hosting — este archivo nunca
# contiene valores reales.

NODE_ENV=production
PORT=4000

# --- Core (fail-fast) ---------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
# mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/esencia_glow?retryWrites=true&w=majority
MONGODB_URI=

# --- Requeridas en producción --------------------------------------------------
CLIENT_URL=https://www.esenciaglow.com
# Opcional pero necesaria para que el front (www.<dominio>) reciba la cookie
# emitida por la API (api.<dominio>) — sin esto el guard de sesión server-side
# del dashboard (Milestone 2.1) no puede validar contra /auth/me. Nota el punto
# inicial: comparte la cookie entre subdominios del mismo dominio registrable,
# sin debilitar `sameSite: "strict"` (www./api. son el mismo sitio).
COOKIE_DOMAIN=.esenciaglow.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enteros positivos — 0 o negativo no arranca el server (loadEnv fail-fast).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RECONCILE_AFTER_MINUTES=10
SUBSCRIPTION_INCOMPLETE_EXPIRE_MINUTES=30
# Días de anticipación con los que el job preventivo avisa al admin que falta
# la edición del ciclo que está por cobrarse (Milestone 1.7.2b). Opcional
# (default 7) — se documenta aquí igual porque el default silencioso puede
# no ser el que Manuel quiere en producción.
SUBSCRIPTION_EDITION_ALERT_DAYS=7
# Saltos de reverse proxy de confianza delante de la API (Railway + Cloudflare).
# REQUERIDA en producción (loadEnv fail-fast) — un default silencioso dejaría
# el fix del hallazgo de auditoría inerte. Confirmar el número real con el
# owner check descrito ahí (loguear req.ip/X-Forwarded-For en producción y
# contar los saltos) antes de fijar el valor definitivo aquí.
TRUST_PROXY_HOPS=2
RESEND_API_KEY=
# Requiere dominio verificado en Resend (DNS) — ver Milestone 4.
RESEND_FROM_EMAIL=no-responder@esenciaglow.com

# --- Auth (Milestone 1.2), opcional: defaults razonables si se omiten --------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Operativas, opcionales incluso en producción ------------------------------
TELEGRAM_BOT_TOKEN=
ADMIN_ALERT_EMAIL=
SENTRY_DSN=

# --- Seed del admin: solo si se ejecuta `pnpm seed:admin` contra producción --
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=

# --- Media del catálogo (Milestone 1.3) ----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=esencia-glow/production
