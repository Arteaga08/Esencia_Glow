# Referencia de variables requeridas en producción. Los valores reales viven
# solo en el secrets manager del proveedor de hosting — este archivo nunca
# contiene valores reales.

NODE_ENV=production
PORT=4000

# --- Core (fail-fast) ---------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
# mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/esencia_glow?retryWrites=true&w=majority
MONGODB_URI=

# --- Requeridas en producción --------------------------------------------------
CLIENT_URL=https://www.esenciaglow.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Requiere dominio verificado en Resend (DNS) — ver Milestone 4.
RESEND_FROM_EMAIL=no-responder@esenciaglow.com

# --- Auth (Milestone 1.2), opcional: defaults razonables si se omiten --------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Operativas, opcionales incluso en producción ------------------------------
TELEGRAM_BOT_TOKEN=
ADMIN_ALERT_EMAIL=
SENTRY_DSN=

# --- Seed del admin: solo si se ejecuta `pnpm seed:admin` contra producción --
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=

# --- Milestone 1.3 (uploadService) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
