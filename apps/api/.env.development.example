# Copiar a .env.development.local y llenar con valores reales de desarrollo.
# Nunca commitear .env.development.local — ver .gitignore.

NODE_ENV=development
PORT=4000

# --- Core (fail-fast, siempre requeridas) ------------------------------------
JWT_SECRET=<random-de-al-menos-48-caracteres-openssl-rand-base64-48>
JWT_REFRESH_SECRET=<otro-random-de-al-menos-48-caracteres-distinto-al-anterior>
ENCRYPTION_KEY=<random-de-al-menos-32-caracteres>
# MongoDB Atlas (SRV). El nombre de la base va en el path, antes del '?'.
# Si el password tiene caracteres especiales, va URL-encoded.
MONGODB_URI=mongodb+srv://<usuario>:<password-url-encoded>@<cluster>.xxxxx.mongodb.net/esencia_glow_dev?retryWrites=true&w=majority

# --- Requeridas en producción, opcionales en dev -----------------------------
CLIENT_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enteros positivos — 0 o negativo no arranca el server (loadEnv fail-fast).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RECONCILE_AFTER_MINUTES=10
RESEND_API_KEY=
# Sin dominio verificado en Resend, dejar el remitente sandbox de abajo.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Auth (Milestone 1.2) -----------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Operativas, siempre opcionales -------------------------------------------
TELEGRAM_BOT_TOKEN=
ADMIN_ALERT_EMAIL=
SENTRY_DSN=

# --- Seed del admin (solo lo lee `pnpm seed:admin`, nunca el server) ---------
SEED_ADMIN_EMAIL=admin@esenciaglow.mx
SEED_ADMIN_PASSWORD=<password-temporal-que-cambiarás-tras-el-primer-login>
SEED_ADMIN_ROLE=admin

# --- Media del catálogo (Milestone 1.3), requeridas en producción, opcionales en dev ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz en Cloudinary. Default esencia-glow/development si se omite.
CLOUDINARY_FOLDER=
