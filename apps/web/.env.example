# Nunca contiene valores reales — ver .gitignore (.env.* está bloqueado salvo
# los .example). Los valores reales viven en .env.local (dev — Next.js lo
# carga tanto en `next dev` como en `next build`, a diferencia de
# .env.development.local, que build no lee) o en el secrets manager del
# proveedor de hosting (producción).

# URL pública de la API — única fuente de verdad, ver lib/config.ts.
# En dev, la API por default corre en el puerto 4000 (apps/api/src/config/env.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Llave PUBLICABLE de Stripe (empieza con pk_). Es la única de Stripe que puede
# vivir en el navegador; la secreta (sk_) y la del webhook van SOLO en apps/api.
# Sin ella, el checkout avisa que los pagos con tarjeta no están disponibles.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cómo se cierra una compra: `whatsapp` (default, sin cobro en línea: el pedido
# viaja como mensaje a la dueña) o `stripe` (checkout con tarjeta y Skydropx).
# Pasar a `stripe` exige las llaves de Stripe de arriba y el API con Skydropx real.
NEXT_PUBLIC_CHECKOUT_MODE=whatsapp

# --- Solo SERVIDOR (jamás NEXT_PUBLIC_*): identidad del servidor web ante el API ---
# Secreto compartido con apps/api (mismo valor que su INTERNAL_API_TOKEN; mínimo
# 32 caracteres, p. ej. `openssl rand -base64 48`). Con él, el servidor web le
# "presta" al API la IP del visitante y los límites de peticiones se cuentan por
# visitante en vez de por servidor. Requerido en producción (el servidor no arranca sin él).
INTERNAL_API_TOKEN=
# Saltos de proxy de confianza DELANTE del servidor web (mismo criterio que
# TRUST_PROXY_HOPS del API): de ahí se toma la IP real del visitante en
# `x-forwarded-for`. Requerido en producción (mínimo 1); confirmar el número real
# registrando la cabecera en el primer despliegue. En dev, 0.
TRUST_PROXY_HOPS=0
