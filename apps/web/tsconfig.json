{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next necesita su propio módulo/resolución (bundler, no NodeNext) y su
    // propio lib de DOM — sobreescribe la base, que apunta a Node puro.
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "isolatedModules": true,
    "incremental": true,
    "allowJs": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"],
  "references": [{ "path": "../../packages/shared" }]
}
